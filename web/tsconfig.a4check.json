// A4's typecheck escape hatch, and the instrument behind every tsc rc=0 A4
// reports while another slot's page is mid-flight.
//
// tsconfig.json includes all of src/, so an uncommitted page that does not
// compile yet fails the whole project's typecheck and leaves A4 no way to
// separate its own files from the breakage. This is tsconfig.json with an
// `exclude` added, generated by:
//
//   python3 -c "import json; s=json.load(open('tsconfig.json')); \
//     s['exclude']=[...]; open('tsconfig.a4check.json','w').write(json.dumps(s,indent=2)+chr(10))"
//   npx tsc -p tsconfig.a4check.json
//
// It expires when the excluded files compile: delete this file rather than
// letting it keep hiding them. Nothing enforces that, which is why the
// exclusion list is the first thing to read here.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/pages/Tags.tsx",
    "src/pages/Tags.test.tsx"
  ]
}
