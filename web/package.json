{
  "name": "@pgsql-insights/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The SPA embedded in the pgsi binary (R10.1). Built with Vite, served by Go via go:embed.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@visx/group": "~4.0.0",
    "@visx/scale": "~4.0.0",
    "@visx/shape": "~4.0.0",
    "@visx/tooltip": "~4.0.0",
    "d3-scale": "~4.0.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.1",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.3",
    "@types/d3-scale": "~4.0.9",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "jsdom": "~31.0.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
