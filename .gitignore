# Binaries and build output
bin/
dist/
# Scratch: throwaway verification programs (the pgversion column dumps
# and similar one-off probes). One ignored dir rather than a new dotdir per
# investigation, so a broad `git add` can never sweep one into a commit.
tmp/
# ...except the web bundle, which IS committed: R11.4 reports its size as a
# number of its own, and go:embed (web/embed.go) needs it so `go build` works
# on a machine with no node toolchain.
!/web/dist/
web/node_modules/
# `npx --prefix web …` also drops a root-level node_modules/ holding nothing but
# vite's cache. The real install is web/node_modules/, so a root one is never
# dependencies — and without this line it shows up as `?? node_modules/` in the
# diff of whoever ran the tests, which is residue in someone else's commit.
node_modules/.vite/
web/e2e/.artifacts/
web/e2e/report/
web/coverage/
*.exe
*.test
*.out

# Go workspace / vendor
vendor/
go.work
go.work.sum

# Environment and secrets
.env
.env.*
*.pem
*.key

# IDE
.idea/
.vscode/

# OS
.DS_Store
__pycache__/
